# Copy to .env and fill in. Never commit .env.
#
# Every value below has a working default in code, so `make up && make seed` runs with this file
# copied verbatim. The only one you must supply yourself is GROQ_API_KEY, and only if you want
# the copilot; everything else works without it.

# local | scale. Changes VALUES only, never behaviour -- there is no code branch on profile.
PROFILE=local

# ----------------------------------------------------------------- datastores
POSTGRES_PASSWORD=devonly
CLICKHOUSE_PASSWORD=devonly
MONGO_PASSWORD=devonly
KEYCLOAK_PASSWORD=devonly
GRAFANA_PASSWORD=devonly

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=voltroute
CLICKHOUSE_DB=voltroute

# The API connects as readyline_app, which owns nothing and holds no DDL rights, so row-level
# security applies to it (ADR-0004). Migrations and seeding run as the owner.
READYLINE_PG_APP_DSN=postgresql://readyline_app:devonly@127.0.0.1:5432/voltroute
READYLINE_PG_OWNER_DSN=postgresql://voltroute:devonly@127.0.0.1:5432/voltroute

# ----------------------------------------------------------------- messaging
KAFKA_BROKERS=localhost:9092
TELEMETRY_TOPIC=telemetry.raw
TELEMETRY_DLQ=telemetry.dlq
TELEMETRY_PARTITIONS=64

# ----------------------------------------------------------------- ingest
INGEST_GROUP=ingest-v1
INGEST_BATCH_ROWS=20000
INGEST_BATCH_SECONDS=2.0
INGEST_DEDUP_CAPACITY=2000000
# Seconds of silence before a consumer exits. 0 = run forever (the production setting).
INGEST_IDLE_EXIT_S=0

# ----------------------------------------------------------------- simulator
SIM_VEHICLES=100000
SIM_TENANTS=60
SIM_LIVE_VEHICLES=2000
SIM_EVENTS_PER_VEHICLE_SEC=1
SIM_DURATION_S=60
SIM_NIGHTS=30
SIM_SEED=20261008
# true throttles to wall-clock for a demo; false runs flat out for throughput measurement.
SIM_REALTIME=false
SIM_BURST_MULTIPLIER=3
SIM_DUPLICATE_RATE=0.004
SIM_OUT_OF_ORDER_RATE=0.012

# ----------------------------------------------------------------- API
API_RATE_LIMIT_PER_MIN=600
API_MAX_PAGE_SIZE=200
OIDC_ISSUER=http://localhost:8080/realms/readyline
# A header is not an identity. true is for the local profile ONLY -- it lets the stack run
# without standing Keycloak up first. Outside local this must be false, and the API then
# requires an OIDC bearer token.
ALLOW_HEADER_AUTH=true

# ----------------------------------------------------------------- scoring
VEWS_BAND_TABLE=vews-1.0.0
BOARD_MAX_ITEMS=12

# ----------------------------------------------------------------- copilot (optional)
# Free key from console.groq.com. Leave blank to run everything except the copilot; its tests
# stub the LLM, so the full suite passes without one.
GROQ_API_KEY=
AGENT_MODEL=openai/gpt-oss-120b
# Purpose-built prompt-injection classifier, run on tool RESULTS as well as user input.
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
AGENT_INJECTION_THRESHOLD=0.8
AGENT_MAX_STEPS=6
