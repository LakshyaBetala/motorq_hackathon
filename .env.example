# Copy to .env. Never commit .env.
PROFILE=local

POSTGRES_PASSWORD=devonly
CLICKHOUSE_PASSWORD=devonly
MONGO_PASSWORD=devonly
KEYCLOAK_PASSWORD=devonly
GRAFANA_PASSWORD=devonly

KAFKA_BROKERS=localhost:9092
TELEMETRY_TOPIC=telemetry.raw
TELEMETRY_PARTITIONS=64

# local: 2000 live streamers out of 100k seeded. scale: raise and add partitions. No code change.
SIM_VEHICLES=100000
SIM_LIVE_VEHICLES=2000
SIM_EVENTS_PER_VEHICLE_SEC=1
SIM_SEED=20261008
SIM_BURST_MULTIPLIER=3
SIM_DUPLICATE_RATE=0.004
SIM_OUT_OF_ORDER_RATE=0.012

VEWS_BAND_TABLE=vews-1.0.0
BOARD_MAX_ITEMS=12
